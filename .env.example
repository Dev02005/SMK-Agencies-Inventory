# Copy to .env.local and fill in from Supabase → Project settings → API keys (the publishable key, never a secret one).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The firm's records online. Empty: they stay in local-data/ on this computer. Set (any long random string, e.g.
# `openssl rand -hex 32`, the same on every server): they are kept in Supabase, in the table set up by
# supabase/migrations/20261103000000_records.sql, which only this key opens. SESSION_SECRET and PERSONAL_LOCK_SECRET
# must then be set too. Copy this computer's records up with `npm run records:upload`.
SKA_DATA_SECRET=

# Sign-in: everyone, the owner too, signs in with their mobile number. Everyone is signed out at 12 midnight (India time).
# SESSION_SECRET: any long random string (e.g. `openssl rand -hex 32`), the same on every server.
SESSION_SECRET=

# Personal section. On sample data on a computer the PIN is 1234; with the records online set both.
# PERSONAL_LOCK_SECRET: any long random string (e.g. `openssl rand -hex 32`), the same on every server.
PERSONAL_PIN=
PERSONAL_LOCK_SECRET=

# The app's public address (e.g. https://app.srikameswari.in), used for link previews, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=
