# Copy to .env.local and fill in from Supabase → Project settings → API keys (the publishable key, never a secret one).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The firm's records online. Empty: they stay in local-data/ on this computer. Set (any long random string, e.g.
# `openssl rand -hex 32`): they are kept in Supabase, in the table set up by
# supabase/migrations/20261103000000_records.sql, which only this key opens. It is the only key the server needs:
# the sign-in and Personal-lock keys are worked out from it, and passwords and the Personal PIN live in Supabase.
# Copy this computer's records up with `npm run records:upload`.
SKA_DATA_SECRET=

# The app's public address (e.g. https://app.srikameswari.in), used for link previews, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=
