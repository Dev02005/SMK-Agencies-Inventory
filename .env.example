# Copy to .env.local and fill in from Supabase → Project settings → API keys.
# While these are empty the app runs on the sample data in src/lib/data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sign-in. Sample login while these are empty: ID 123456789, password 123456789. Everyone is signed out at 12 midnight (India time).
# SESSION_SECRET: any long random string (e.g. `openssl rand -hex 32`), the same on every server.
SKA_LOGIN_ID=
SKA_LOGIN_PASSWORD=
SESSION_SECRET=

# Personal section. On sample data the PIN is 1234; with real data set both.
# PERSONAL_LOCK_SECRET: any long random string (e.g. `openssl rand -hex 32`), the same on every server.
PERSONAL_PIN=
PERSONAL_LOCK_SECRET=

# The app's public address (e.g. https://app.srikameswari.in), used for link previews, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=
